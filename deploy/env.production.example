# /data/projects/ai-callcenter/.env  — 운영 환경 전용 (gitignored)
# install.sh 가 처음 한 번만 이 파일을 복사해 생성합니다.
# 절대 git 에 커밋하지 마세요 (.gitignore 가 .env 를 제외함).

# ====================================================================
# 1. AI 제공자
# ====================================================================
# auto: Claude 키가 있으면 Claude, 없으면 Ollama, 둘 다 없으면 mock
# claude / ollama / mock 으로 강제 가능
AI_PROVIDER=auto

# Claude (AI_PROVIDER=claude 또는 auto)
# https://console.anthropic.com/ 에서 키 발급
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7

# Ollama (AI_PROVIDER=ollama 또는 auto)
OLLAMA_BASE_URL=http://192.168.45.214:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# ====================================================================
# 2. 초기 관리자
# ====================================================================
# DB 가 비어있을 때만 1회 자동 생성. install.sh 가 강한 랜덤 비밀번호로 채움.
# 첫 로그인 후 반드시 /security 에서 비밀번호 변경 + 2FA 활성화.
ADMIN_INIT_PASSWORD=__CHANGE_ME__

# ====================================================================
# 3. 외부 알림 (Slack / Teams / Discord Incoming Webhook)
# ====================================================================
# 위험 상담·콜백·이상 활동 시 푸시. 비워두면 비활성.
ALERT_WEBHOOK_URL=

# ====================================================================
# 4. 이메일 (비밀번호 재설정 링크)
# ====================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@callcenter.example.com

# 재설정 링크용 — 운영 도메인 (https 포함, 슬래시 없이)
APP_BASE_URL=https://callcenter.example.com

# ====================================================================
# 5. 데이터베이스
# ====================================================================
DATABASE_URL=sqlite:///./callcenter.db

# 자동 백업 (SQLite 만 지원)
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# ====================================================================
# 6. 보안 — 운영에선 모두 true 권장
# ====================================================================
RATELIMIT_ENABLED=true

# ====================================================================
# 7. AI 음성 응답 (TTS)
# ====================================================================
# auto: edge-tts 가 가능하면 사용, 안 되면 espeak-ng 폴백
TTS_ENGINE=auto
TTS_VOICE=ko-KR-SunHiNeural

# ====================================================================
# 8. 음성 인식 (Whisper STT)
# ====================================================================
# 첫 실행 시 HuggingFace 에서 모델 다운로드 (~140 MB, 1회).
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_LANG=ko
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# 다운로드 속도/한도 ↑ (선택). https://huggingface.co/settings/tokens
HF_TOKEN=

# ====================================================================
# 9. 영업 시간 (평일 기준)
# ====================================================================
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18

# ====================================================================
# 10. A/B 프롬프트 실험
# ====================================================================
# 운영에서 실험하려면 true 로. 50% 의 새 상담이 B 변형으로 라우팅됨.
AB_EXPERIMENT_ENABLED=false
AB_EXPERIMENT_RATIO_B=0.5
