# AI 제공자: auto | claude | ollama | mock
#   auto   - Claude 키가 있으면 Claude, 없으면 Ollama, 둘 다 없으면 mock
#   claude - 실제 Claude API 사용
#   ollama - 로컬·원격 Ollama 서버 사용 (기본값)
#   mock   - 모의 응답만 사용
AI_PROVIDER=ollama

# --- Claude API (AI_PROVIDER=claude 또는 auto) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7

# --- AI 음성 응답 (TTS) ---
# 엔진: auto | edge | espeak
#   auto   - edge-tts 가능하면 우선, 안 되면 espeak-ng 폴백 (기본값)
#   edge   - Edge TTS 강제 (인터넷 필요, 자연스러운 한국어)
#   espeak - 오프라인 espeak-ng 강제 (기계적이지만 항상 동작)
TTS_ENGINE=auto
# Edge TTS 기본 음성 (선희 여성). 변경 후보:
#   ko-KR-InJoonNeural   (남), ko-KR-HyunsuNeural (남, 신규)
#   ko-KR-JiMinNeural    (여), ko-KR-SeoHyeonNeural (여)
TTS_VOICE=ko-KR-SunHiNeural

# --- 음성 인식 (Whisper) ---
# 모델 크기: tiny / base / small / medium / large  (한국어는 base 이상 권장)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_LANG=ko
# 첫 실행 시 HuggingFace 에서 모델을 받아 캐시(~/.cache/huggingface)에 보관합니다.
# (선택) 다운로드 경고 음소거 — 무해하지만 콘솔이 깔끔해짐
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# (선택) HF 토큰을 지정하면 rate-limit/속도 ↑  https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Ollama (AI_PROVIDER=ollama 또는 auto) ---
# 기본 사내 Ollama 서버. 다른 환경에서는 이 값을 바꿔서 사용.
OLLAMA_BASE_URL=http://192.168.45.214:11434
OLLAMA_MODEL=llama3.1
# 상담 학습(RAG) 의미 검색용 임베딩 모델. Ollama 서버에 미리 받아둬야 함.
# 사용 전 `ollama pull nomic-embed-text` 필요.
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- 이메일 (비밀번호 재설정 링크 발송) ---
# SMTP_HOST 를 비워두면 재설정 링크가 서버 로그로 출력됩니다(개발용 폴백).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ai-callcenter.local
# 재설정 링크의 기본 URL (미설정 시 요청 URL 사용)
APP_BASE_URL=

# --- A/B 프롬프트 실험 ---
# AI 답변 프롬프트의 A(기본) vs B(공감→답변→다음행동) 비교 실험.
# enable 하면 신규 상담을 ratio 비율로 무작위 배정 (예: 0.5 = 50%/50%).
# 결과는 /api/admin/experiments/ai_variant 에서 비교.
AB_EXPERIMENT_ENABLED=false
AB_EXPERIMENT_RATIO_B=0.5

# --- 외부 알림 (Slack / Teams / Discord Incoming Webhook) ---
# URL 을 설정하면 고위험 상담·에스컬레이션 발생 시 외부 채널로 푸시 알림.
# Slack: https://api.slack.com/messaging/webhooks
# Teams: https://learn.microsoft.com/microsoftteams/platform/webhooks-and-connectors/
# Discord: 채널 설정 → 통합 → 웹후크 추가
# 빈 값이면 알림 기능이 비활성화됨.
ALERT_WEBHOOK_URL=

# --- 콜센터 초기 관리자 ---
# DB가 비어있을 때만 1회 자동 생성됩니다. 첫 로그인 후 반드시 변경하세요.
ADMIN_INIT_PASSWORD=admin1234

# 데이터베이스 (기본: 프로젝트 루트의 SQLite 파일)
DATABASE_URL=sqlite:///./callcenter.db

# --- 레이트 리미트 (익명 엔드포인트 보호) ---
# false 면 모든 리미트 비활성 (개발/테스트 편의). 기본 true.
RATELIMIT_ENABLED=true

# --- 자동 백업 (SQLite 만 지원) ---
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
