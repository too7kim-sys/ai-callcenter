# AI 제공자: auto | claude | ollama | mock
#   auto   - Claude 키가 있으면 Claude, 없으면 Ollama, 둘 다 없으면 mock (기본값)
#   claude - 실제 Claude API 사용
#   ollama - 로컬 Ollama 서버 사용
#   mock   - 모의 응답만 사용
AI_PROVIDER=auto

# --- Claude API (AI_PROVIDER=claude 또는 auto) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7

# --- Ollama (AI_PROVIDER=ollama 또는 auto) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# 상담 학습(RAG) 의미 검색용 임베딩 모델. Ollama가 있으면 자동 사용.
# 사용 전 `ollama pull nomic-embed-text` 필요.
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- 이메일 (비밀번호 재설정 링크 발송) ---
# SMTP_HOST 를 비워두면 재설정 링크가 서버 로그로 출력됩니다(개발용 폴백).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ai-callcenter.local
# 재설정 링크의 기본 URL (미설정 시 요청 URL 사용)
APP_BASE_URL=

# 데이터베이스 (기본: 프로젝트 루트의 SQLite 파일)
DATABASE_URL=sqlite:///./callcenter.db
